# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="mysql://username:password@localhost:3306/database_name"



# Server
PORT=5000
NODE_ENV=development


# JWT
JWT_ACCESS_SECRET=your-access-secret-key-min-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# # Client
# CLIENT_URL=http://localhost:3000









# Client


# Email — Resend-only (https://resend.com)
# Get a live API key: https://resend.com/api-keys
# NOTE: Resend dev sandbox only allows sending TO the account email you verified with.
#       For real production deliveries, add + verify your sending domain in Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RFC-5322 "Sender Name <addr@domain>" — use EXACTLY this format (quoting only if name has spaces).
EMAIL_FROM="BishwasSetu <onboarding@resend.dev>"

# Optional: Resend audience (contact list) for tagging transactional deliveries
# RESEND_AUDIENCE_ID=aud_xxxxxxxxxxx

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
# Anti-bruteforce: after N failed attempts, lock for OTP_LOCKOUT_MINUTES
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# rate limiting 
OTP_RATE_LIMIT_WINDOW=15
OTP_RATE_LIMIT_MAX=5
RESEND_OTP_RATE_LIMIT_WINDOW=5
RESEND_OTP_RATE_LIMIT_MAX=3


# Frontend URLs
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Cloudinary (Avatar & Document uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
Cloud_Name=your-cloud-name
Cloud_API_KEY=your-cloudinary-api-key
Cloud_API_SECRET=your-cloudinary-api-secret

# Khalti Payment
KHALTI_SECRET_KEY=test_secret_key_xxxxx
KHALTI_RETURN_URL=http://localhost:5173/payment/success
KHALTI_WEBSITE_URL=http://localhost:5173
KHALTI_ENVIRONMENT=test
KHALTI_REQUEST_TIMEOUT=15000
KHALTI_MAX_RETRIES=3
KHALTI_RETRY_DELAY_MS=1000

# eSewa Payment
ESEWA_SECRET_KEY=your-esewa-secret
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SUCCESS_URL=http://localhost:5173/payment/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/failure
ESEWA_ENVIRONMENT=development

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_HEARTBEAT_INTERVAL=25000
SOCKET_HEARTBEAT_TIMEOUT=20000
SOCKET_MAX_CONNECTIONS_PER_USER=5
